# Required by SEC EDGAR, courteous for OEB: identify yourself.
REGRAG_USER_AGENT="regrag-research/0.1 (you@example.com)"
# Vector store: pgvector (default, see scripts/local_pg.sh) or local (numpy, no DB)
REGRAG_VECTOR_STORE=pgvector
DATABASE_URL=postgresql://postgres@localhost:5433/utility_rag
# Claude answer generation (loaded from this .env by the app). Without it, answers are extractive.
ANTHROPIC_API_KEY=
REGRAG_LLM_MODEL=claude-opus-5
# Object storage root; any fsspec URL works (install extras: pip install -e ".[cloud]")
REGRAG_LAKE_ROOT=data/lake
